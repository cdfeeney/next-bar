# iOS TestFlight lane. Runs on the macos GitHub Actions runner (fastlane
# preinstalled).
#
# SIGNING (CERT-01, 2026-09-20): ONE fixed Apple Distribution certificate and
# ONE App Store provisioning profile, both stored as GitHub secrets and
# imported into a throwaway keychain at the start of the lane. Until build 13
# this lane used Xcode "automatic" cloud signing, which on a fresh runner
# (empty keychain, so no private key it recognises) minted a NEW distribution
# certificate on EVERY run — Apple caps those per team, and build 13 died on
# "Your account has reached the maximum number of certificates". The private
# key never leaves the secret; nothing here is written to the repo.
#
# Required env (GitHub secrets, see docs/IOS-TESTFLIGHT-RUNBOOK.md):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64, APPLE_TEAM_ID   (upload)
#   IOS_DIST_P12_PATH, IOS_DIST_P12_PASSWORD                      (certificate + key, decoded by the workflow)
#   IOS_PROFILE_PATH                                              (App Store profile, decoded by the workflow)
#   BUILD_NUMBER (github.run_number)

require "securerandom"

default_platform(:ios)

APP_IDENTIFIER = "com.nextbar.app"
XCODEPROJ = "ios/App/App.xcodeproj"

platform :ios do
  desc "Build the Capacitor shell and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    # 1. A private keychain for this run, holding only our certificate.
    keychain_name = "nextbar-ci.keychain-db"
    keychain_password = SecureRandom.hex(16)
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_P12_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_P12_PASSWORD"),
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      log_output: true
    )

    # 2. The profile, installed where Xcode looks, and identified by the NAME
    #    inside the file (never a value typed into the portal by hand).
    profile_path = ENV.fetch("IOS_PROFILE_PATH")
    installed_profile = install_provisioning_profile(path: profile_path)
    profile_name = FastlaneCore::ProvisioningProfile.parse(profile_path)["Name"]
    UI.user_error!("The provisioning profile has no Name") if profile_name.to_s.empty?
    UI.message("Signing with profile '#{profile_name}' (#{installed_profile})")

    # 3. Manual signing on the App target: this certificate, this profile.
    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: XCODEPROJ,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "NextBar.ipa",
      destination: "generic/platform=iOS",
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}"
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  ensure
    # Never leave the certificate on the runner past the lane, even on failure.
    delete_keychain(name: keychain_name) if keychain_name && File.exist?(File.expand_path("~/Library/Keychains/#{keychain_name}"))
  end
end
