# iOS TestFlight lane. Runs on the macos GitHub Actions runner (fastlane
# preinstalled). Signing is Xcode cloud signing via the App Store Connect
# API key — no certificates or profiles are stored in this repo.
#
# Required env (set as GitHub secrets, see docs/IOS-TESTFLIGHT-RUNBOOK.md):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64, APPLE_TEAM_ID
#   ASC_KEY_PATH (path to decoded .p8, written by the workflow)
#   BUILD_NUMBER (github.run_number)

default_platform(:ios)

platform :ios do
  desc "Build the Capacitor shell and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "NextBar.ipa",
      destination: "generic/platform=iOS",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}"
      ].join(" "),
      # Signing lessons from the first live runs (2026-08-03), so nobody
      # relearns them: (1) automatic signing archives with a DEVELOPMENT
      # profile, and development profiles require >=1 registered device on
      # the team — register a device before dispatching. (2) Overriding
      # CODE_SIGN_IDENTITY='Apple Distribution' via xcargs conflicts with
      # automatic signing ("conflicting provisioning settings") — don't.
      # The app-store re-sign happens at export, driven by export_options.
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
