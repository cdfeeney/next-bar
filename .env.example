NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Legacy re-hosted Google Place photos (public/bar-photos/, ~3,435 files).
# FAIL-CLOSED: must be exactly '1' to serve them. Anything else — absent,
# empty, 'true', 'false', a typo — resolves to OFF.
#
# Google's Places policy exempts place_id from its caching restrictions but
# does NOT permit re-hosting photo content, so these files are a known
# liability being migrated onto the Places UI Kit
# (see docs/UI-KIT-BUILD-PLAN.md). Set to 1 in current deployments so cards
# keep their photos until the UI Kit path renders; drop it surface by
# surface as that lands.
NEXT_PUBLIC_LEGACY_PHOTOS=1

# Live Google Places UI Kit media. Must be exactly '1'. Leave unset until the
# UI Kit integration ships WITH a server-enforced spend cap — every card
# render is a billable event.
# NEXT_PUBLIC_GOOGLE_MEDIA=1
