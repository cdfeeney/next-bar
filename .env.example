NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Places UI Kit (browser-restricted public key). Enable only on the
# staging deployment until the preview is approved.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MEDIA=1
# GOOGLE_MEDIA_RUNTIME_ENABLED=1

# --- Database environment identity (required by the live RLS suite) ---
# Supabase's pooler hostname is shared and the project ref lives in the
# username, so a connection string alone cannot tell staging from production.
# src/lib/nightOutsRls.live.test.ts writes to whatever DATABASE_URL names and
# therefore refuses to run unless the ref is named here explicitly.
NEXT_BAR_DATABASE_ENVIRONMENT=staging
NEXT_BAR_PRODUCTION_PROJECT_REF=
NEXT_BAR_STAGING_PROJECT_REFS=

# --- Pooler certificate (required by scripts/apply-migration-set.ts) ---
# The ref above is only a string someone typed; the certificate is what proves
# the host answering that name is really Supabase. The pooler serves a
# SELF-SIGNED chain, so verification needs Supabase's own CA: download it from
# the dashboard (Settings - Database - SSL configuration), keep it OUT of the
# repo, and point this at the file. apply-migration-set.ts refuses to run
# without it rather than connecting unauthenticated; the live RLS suite uses it
# when present and is encrypted-only when it is not.
PGSSLROOTCERT=
