NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Places UI Kit (browser-restricted public key). Enable only on the
# staging deployment until the preview is approved.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MEDIA=1
# GOOGLE_MEDIA_RUNTIME_ENABLED=1

# --- Database environment identity (required by the live RLS suite) ---
# Supabase's pooler hostname is shared and the project ref lives in the
# username, so a connection string alone cannot tell staging from production.
# src/lib/nightOutsRls.live.test.ts writes to whatever DATABASE_URL names and
# therefore refuses to run unless the ref is named here explicitly.
NEXT_BAR_DATABASE_ENVIRONMENT=staging
NEXT_BAR_PRODUCTION_PROJECT_REF=
NEXT_BAR_STAGING_PROJECT_REFS=

# --- Native iOS push / APNs (V8-4). SERVER ONLY, STAGING ONLY. ---
# None of these may ever take a NEXT_PUBLIC_ prefix: that prefix is the one
# thing that would let Next.js inline a credential into the browser bundle.
# scripts/check-client-apns-bundle.mjs proves the built chunks stay clean.
#
# The .p8 key, its Key ID, and the Push Notifications capability on the
# com.nextbar.app App ID are ATTENDED credentials. Until they exist the outbox
# accumulates and the drain endpoint returns {ok:true, skipped:...} — that is
# the designed unconfigured state, not a failure.
#
# APNS_ENVIRONMENT must be `sandbox`. Any other value is REFUSED at startup:
# enabling the production APNs environment is an attended decision, never a
# config typo. See docs/APNS-DEVICE-TESTING.md.
# APNS_ENVIRONMENT=sandbox
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.nextbar.app
# APNS_PRIVATE_KEY=
#
# Shared secret for POST /api/notifications/drain. Unset means the endpoint is
# CLOSED, not open.
# NOTIFICATIONS_DRAIN_SECRET=
